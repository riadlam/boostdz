APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BuzzerPanel SMM provider
BUZZERPANEL_API_URL=https://buzzerpanel.id/api/json.php
BUZZERPANEL_API_KEY=
BUZZERPANEL_SECRET_KEY=
BUZZERPANEL_DEFAULT_MARKUP=20
BUZZERPANEL_SERVICES_ACTION=services3
BUZZERPANEL_DEFAULT_REFILL_DAYS=30
BUZZERPANEL_STATUS_POLL_MIN_SECONDS=20
BUZZERPANEL_PROVIDER_SLUG=buzzerpanel
BUZZERPANEL_PROVIDER_NAME=BuzzerPanel

# Platforms synced from BuzzerPanel but hidden on the website (sell via Telegram later)
CATALOG_WEB_DISABLED_PLATFORMS=telegram,spotify,linkedin,other

# Catalog sync: update_only (default) refreshes existing packages only; full imports new services
CATALOG_SYNC_MODE=update_only
# Send Telegram alerts for name changes and skipped new packages (when bot is configured)
CATALOG_NOTIFY_TELEGRAM=true

# Default IDR → DZD rate used by ProviderSeeder (legacy; pricing uses EUR bridge below)
DEFAULT_IDR_DZD_RATE=0.0085

# User-facing price: IDR (BuzzerPanel) → EUR → DZD + markup
# 1 EUR = PRICING_EUR_IDR IDR | 1 EUR = PRICING_EUR_DZD DA | markup on base DZD
PRICING_EUR_IDR=20700
PRICING_EUR_DZD=280
PRICING_MARKUP_PERCENT=50
# After changing rates/markup, run: php artisan pricing:refresh-sell-rates

# Minimum order charge and minimum wallet top-up (DZD). Set 0 to disable.
CHECKOUT_MINIMUM_AMOUNT_DZD=500

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Telegram admin review for CCP / BaridiMob receipts
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# true = place order right after CCP receipt upload (local). false = wait for Telegram Accept.
TELEGRAM_AUTO_ACCEPT=true
